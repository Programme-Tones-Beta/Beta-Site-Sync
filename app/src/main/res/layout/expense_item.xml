<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="item"
            type="com.example.android.trackr.data.ExpenseItem" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/expense_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@{item.title}"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    tools:text="Client Lunch" />

                <TextView
                    android:id="@+id/expense_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{@string/amount_format(item.amount)}"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    tools:text="$45.50" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/expense_category"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@{item.category}"
                    android:textAppearance="?attr/textAppearanceBody2"
                    tools:text="Meals" />

                <TextView
                    android:id="@+id/expense_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{item.locationInfo}"
                    android:textAppearance="?attr/textAppearanceCaption"
                    tools:text="Downtown Office" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/expense_receipt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@{item.receiptPhotoUri != null ? @string/receipt_attached : @string/no_receipt}"
                    android:textAppearance="?attr/textAppearanceCaption"
                    tools:text="Receipt attached" />

                <Button
                    android:id="@+id/upload_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{item.uploaded ? @string/uploaded : @string/upload_to_office}"
                    android:enabled="@{!item.uploaded}"
                    style="?attr/materialButtonOutlinedStyle"
                    tools:text="Upload to Office" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
