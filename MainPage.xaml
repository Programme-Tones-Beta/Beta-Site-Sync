<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SiteSyncTracker.MainPage"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Label Text="Site Overview"
                   FontSize="26"
                   FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Border Grid.Row="0" Grid.Column="0" Padding="16" StrokeShape="RoundRectangle 8"
                        BackgroundColor="{StaticResource StatusAmber}">
                    <VerticalStackLayout>
                        <Label Text="12" FontSize="36" FontAttributes="Bold" TextColor="White" />
                        <Label Text="In Transit" TextColor="White" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Padding="16" StrokeShape="RoundRectangle 8"
                        BackgroundColor="{StaticResource StatusBlue}">
                    <VerticalStackLayout>
                        <Label Text="48" FontSize="36" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Delivered to Yard" TextColor="White" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Padding="16" StrokeShape="RoundRectangle 8"
                        BackgroundColor="{StaticResource SafetyOrange}">
                    <VerticalStackLayout>
                        <Label Text="21" FontSize="36" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Staged on Level" TextColor="White" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="16" StrokeShape="RoundRectangle 8"
                        BackgroundColor="{StaticResource StatusGreen}">
                    <VerticalStackLayout>
                        <Label Text="95" FontSize="36" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Installed" TextColor="White" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Quick Actions" FontSize="20" FontAttributes="Bold" />

            <Button Text="Goods In (Receive)"
                    HeightRequest="64"
                    FontSize="20"
                    BackgroundColor="{StaticResource StatusGreen}"
                    TextColor="White"
                    SemanticProperties.Hint="Opens the goods in form" />
            <Button Text="Goods Out (Issue)"
                    HeightRequest="64"
                    FontSize="20"
                    BackgroundColor="{StaticResource SafetyOrange}"
                    TextColor="White"
                    SemanticProperties.Hint="Opens the goods out form" />
            <Button Text="Scan Manifest"
                    HeightRequest="64"
                    FontSize="20"
                    SemanticProperties.Hint="Scans a manifest barcode" />

            <Label Text="Recent Activity" FontSize="20" FontAttributes="Bold" />

            <Border Padding="12" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray300}">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label Grid.Row="0" Text="MAN-1042 Rebar bundles" FontAttributes="Bold" />
                    <Label Grid.Row="1" Text="Main Laydown Yard" TextColor="{StaticResource Gray500}" />
                    <Label Grid.RowSpan="2" Grid.Column="1" Text="Delivered" VerticalOptions="Center"
                           TextColor="{StaticResource StatusBlue}" FontAttributes="Bold" />
                </Grid>
            </Border>
            <Border Padding="12" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray300}">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label Grid.Row="0" Text="MAN-1038 Steel beams" FontAttributes="Bold" />
                    <Label Grid.Row="1" Text="Level 1 Structure" TextColor="{StaticResource Gray500}" />
                    <Label Grid.RowSpan="2" Grid.Column="1" Text="Staged" VerticalOptions="Center"
                           TextColor="{StaticResource SafetyOrange}" FontAttributes="Bold" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
