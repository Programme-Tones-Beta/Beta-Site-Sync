<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SiteSyncTracker.Views.GoodsOutPage"
             Title="Goods Out">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Issue Materials" FontSize="26" FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Manifest Number" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Placeholder="MAN-0000" MaxLength="50" HeightRequest="52" />
                <Button Grid.Column="1" Text="Scan" WidthRequest="96" HeightRequest="52" />
            </Grid>

            <Border Padding="12" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray300}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="MAN-1038 Steel beams" FontAttributes="Bold" />
                    <Label Text="On hand: 40" TextColor="{StaticResource Gray500}" />
                    <Label Text="Current location: Main Laydown Yard" TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Quantity Out" />
            <Entry Keyboard="Numeric" Placeholder="0" HeightRequest="52" />

            <Label Text="Move To" />
            <Picker Title="Select destination" HeightRequest="52">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Main Laydown Yard</x:String>
                        <x:String>Level 1 Structure</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="New Status" />
            <Picker Title="Select status" HeightRequest="52">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>In Transit</x:String>
                        <x:String>Delivered to Yard</x:String>
                        <x:String>Staged on Level</x:String>
                        <x:String>Installed</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Notify (phone or email)" />
            <Entry Placeholder="supervisor@example.com or +1 555 0100" Keyboard="Email" MaxLength="255" HeightRequest="52" />

            <Button Text="Confirm Issue"
                    HeightRequest="64"
                    FontSize="20"
                    Margin="0,12,0,0"
                    BackgroundColor="{StaticResource SafetyOrange}"
                    TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
