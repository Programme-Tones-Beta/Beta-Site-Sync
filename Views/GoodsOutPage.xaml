<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SiteSyncTracker.Views.GoodsOutPage"
             Title="Goods Out"
             BackgroundColor="#F7F7F7">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#F7F7F7">
        <!-- Header with Back Navigation -->
        <Grid Grid.Row="0" Padding="14,10,16,10" ColumnDefinitions="Auto,*" BackgroundColor="White">
            <Button Text="← Back"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="#1565C0"
                    FontAttributes="Bold"
                    FontSize="16"
                    BorderWidth="0"
                    Padding="4,0"
                    SemanticProperties.Description="Back to Dashboard" />
            <Label Grid.Column="1"
                   Text="Goods Out (Issue Materials)"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#1F1F1F"
                   VerticalOptions="Center"
                   Margin="8,0,0,0" />
        </Grid>
        <BoxView Grid.Row="0" VerticalOptions="End" HeightRequest="1" Color="#E0E0E0" />

        <!-- Form ScrollView -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,16" Spacing="16">
                <Border Padding="16" BackgroundColor="White" StrokeThickness="1" Stroke="#E0E0E0" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Issue Request Details" FontSize="18" FontAttributes="Bold" TextColor="#1F1F1F" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Manifest Number *" FontSize="14" FontAttributes="Bold" TextColor="#424242" />
                            <Entry x:Name="ManifestEntry"
                                   Placeholder="e.g. MAN-1042"
                                   MaxLength="50"
                                   HeightRequest="48"
                                   SemanticProperties.Hint="Enter manifest number of materials being issued" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Quantity Out *" FontSize="14" FontAttributes="Bold" TextColor="#424242" />
                            <Entry x:Name="QuantityEntry"
                                   Placeholder="Number of items to issue"
                                   Keyboard="Numeric"
                                   HeightRequest="48"
                                   SemanticProperties.Hint="Enter quantity to issue" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Transfer To Location *" FontSize="14" FontAttributes="Bold" TextColor="#424242" />
                            <Picker x:Name="LocationPicker"
                                    Title="Select destination zone"
                                    ItemDisplayBinding="{Binding ZoneName}"
                                    HeightRequest="48"
                                    SemanticProperties.Hint="Choose destination location" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Updated Status *" FontSize="14" FontAttributes="Bold" TextColor="#424242" />
                            <Picker x:Name="StatusPicker"
                                    Title="Select new status"
                                    ItemDisplayBinding="{Binding StatusName}"
                                    HeightRequest="48"
                                    SemanticProperties.Hint="Choose new status" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Action Button -->
                <Button Text="Confirm Material Issue"
                        HeightRequest="56"
                        FontSize="17"
                        FontAttributes="Bold"
                        Clicked="OnConfirmIssueClicked"
                        BackgroundColor="#E5541F"
                        TextColor="White"
                        CornerRadius="12"
                        SemanticProperties.Description="Confirm Material Issue"
                        SemanticProperties.Hint="Records the issue and updates stock quantities" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar -->
        <Grid Grid.Row="2"
              Padding="10,10,10,14"
              ColumnDefinitions="*,*,*,*"
              BackgroundColor="White">
            <BoxView VerticalOptions="Start" HeightRequest="1" Grid.ColumnSpan="4" Color="#E5E5E5" Margin="0,-10,0,0" />

            <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center" Padding="8,6"
                                 SemanticProperties.Description="Dashboard Tab. Tap to navigate to Dashboard.">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDashboardNavClicked" />
                </VerticalStackLayout.GestureRecognizers>
                <Ellipse Fill="#757575" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" />
                <Label Text="Dashboard" FontSize="13" TextColor="#424242" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center" Padding="8,6"
                                 SemanticProperties.Description="Goods In Tab. Tap to navigate to Receive Delivery.">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGoodsInNavClicked" />
                </VerticalStackLayout.GestureRecognizers>
                <Ellipse Fill="#757575" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" />
                <Label Text="Goods In" FontSize="13" TextColor="#424242" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center" Padding="8,6"
                                 SemanticProperties.Description="Goods Out Tab. Selected.">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGoodsOutNavClicked" />
                </VerticalStackLayout.GestureRecognizers>
                <Ellipse Fill="#D61B7A" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" />
                <Label Text="Goods Out" FontSize="13" FontAttributes="Bold" TextColor="#D61B7A" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center" Padding="8,6"
                                 SemanticProperties.Description="Inventory Tab. Tap to navigate to Inventory search.">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnInventoryNavClicked" />
                </VerticalStackLayout.GestureRecognizers>
                <Ellipse Fill="#757575" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" />
                <Label Text="Inventory" FontSize="13" TextColor="#424242" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
