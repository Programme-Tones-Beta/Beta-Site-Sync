<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SiteSyncTracker.Views.GoodsOutPage" Title="Goods Out">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Issue Materials" FontSize="26" FontAttributes="Bold" />
            <Entry x:Name="ManifestEntry" Placeholder="Manifest number" MaxLength="50" />
            <Entry x:Name="QuantityEntry" Placeholder="Quantity out" Keyboard="Numeric" />
            <Picker x:Name="LocationPicker" Title="Move to" ItemDisplayBinding="{Binding ZoneName}" />
            <Picker x:Name="StatusPicker" Title="New status" ItemDisplayBinding="{Binding StatusName}" />
            <Button Text="Confirm Issue" Clicked="OnConfirmIssueClicked" BackgroundColor="{StaticResource SafetyOrange}" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
