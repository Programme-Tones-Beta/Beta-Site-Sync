<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SiteSyncTracker.Views.InventoryPage"
             Title="Inventory"
             BackgroundColor="#F7F7F7">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" BackgroundColor="#F7F7F7">
        <!-- Header with Back & Action -->
        <Grid Grid.Row="0" Padding="14,10,16,10" ColumnDefinitions="Auto,*,Auto" BackgroundColor="White">
            <Button Text="← Back"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="#1565C0"
                    FontAttributes="Bold"
                    FontSize="16"
                    BorderWidth="0"
                    Padding="4,0"
                    SemanticProperties.Description="Back to Dashboard" />
            <Label Grid.Column="1"
                   Text="Site Inventory"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#1F1F1F"
                   VerticalOptions="Center"
                   Margin="8,0,0,0" />
            <Button Grid.Column="2"
                    Text="+ Receive"
                    Clicked="OnReceiveNewDeliveryClicked"
                    BackgroundColor="#1F8C48"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="14"
                    CornerRadius="8"
                    HeightRequest="36"
                    Padding="10,0"
                    SemanticProperties.Description="Receive new delivery" />
        </Grid>
        <BoxView Grid.Row="0" VerticalOptions="End" HeightRequest="1" Color="#E0E0E0" />

        <!-- Search Bar -->
        <Grid Grid.Row="1" Padding="16,12,16,6">
            <SearchBar x:Name="SearchEntry"
                       Placeholder="Search manifest or description..."
                       TextChanged="OnSearchTextChanged"
                       HeightRequest="48"
                       BackgroundColor="White"
                       SemanticProperties.Hint="Type to filter inventory by manifest number or description" />
        </Grid>

        <!-- Loading Activity Indicator -->
        <ActivityIndicator x:Name="LoadingIndicator"
                           Grid.Row="2"
                           IsVisible="False"
                           IsRunning="{Binding IsVisible, Source={x:Reference LoadingIndicator}}"
                           HorizontalOptions="Center"
                           Color="#1565C0"
                           Margin="0,4" />

        <!-- Inventory List -->
        <CollectionView x:Name="InventoryList"
                        Grid.Row="3"
                        EmptyView="No inventory items found."
                        Margin="16,4,16,8">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14,12"
                            Margin="0,0,0,10"
                            Stroke="#E0E0E0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="White">
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="4">
                            <Label Text="{Binding ManifestNumber}"
                                   FontAttributes="Bold"
                                   FontSize="17"
                                   TextColor="#1F1F1F" />
                            <Label Grid.Row="1"
                                   Text="{Binding Description}"
                                   FontSize="14"
                                   TextColor="#424242"
                                   LineBreakMode="WordWrap" />
                            <HorizontalStackLayout Grid.Row="2" Spacing="16" Margin="0,4,0,0">
                                <Label Text="{Binding QuantityReceived, StringFormat='Received: {0}'}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#2E7D32" />
                                <Label Text="{Binding QuantityExpected, StringFormat='Expected: {0}'}"
                                       FontSize="13"
                                       TextColor="#666666" />
                            </HorizontalStackLayout>
                            <Label Grid.Row="3"
                                   Text="{Binding DateUpdated, StringFormat='Updated: {0:g}'}"
                                   FontSize="12"
                                   TextColor="#888888" />

                            <VerticalStackLayout Grid.RowSpan="4"
                                                 Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="End">
                                <Border Padding="8,4"
                                        BackgroundColor="#E3F2FD"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6">
                                    <Label Text="{Binding CurrentStatus.StatusName}"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           TextColor="#1565C0" />
                                </Border>
                                <Label Text="{Binding CurrentLocation.ZoneName}"
                                       FontSize="13"
                                       TextColor="#666666"
                                       HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom Navigation Bar -->
        <Grid Grid.Row="4"
              Padding="10,10,10,14"
              ColumnDefinitions="*,*,*,*"
              BackgroundColor="White">
            <BoxView VerticalOptions="Start" HeightRequest="1" Grid.ColumnSpan="4" Color="#E5E5E5" Margin="0,-10,0,0" />

            <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center" Padding="8,6"
                                 SemanticProperties.Description="Dashboard Tab. Tap to navigate to Dashboard.">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDashboardNavClicked" />
                </VerticalStackLayout.GestureRecognizers>
                <Ellipse Fill="#757575" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" />
                <Label Text="Dashboard" FontSize="13" TextColor="#424242" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center" Padding="8,6"
                                 SemanticProperties.Description="Goods In Tab. Tap to navigate to Receive Delivery.">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGoodsInNavClicked" />
                </VerticalStackLayout.GestureRecognizers>
                <Ellipse Fill="#757575" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" />
                <Label Text="Goods In" FontSize="13" TextColor="#424242" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center" Padding="8,6"
                                 SemanticProperties.Description="Goods Out Tab. Tap to navigate to Issue Materials.">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGoodsOutNavClicked" />
                </VerticalStackLayout.GestureRecognizers>
                <Ellipse Fill="#757575" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" />
                <Label Text="Goods Out" FontSize="13" TextColor="#424242" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center" Padding="8,6"
                                 SemanticProperties.Description="Inventory Tab. Selected.">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnInventoryNavClicked" />
                </VerticalStackLayout.GestureRecognizers>
                <Ellipse Fill="#D61B7A" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" />
                <Label Text="Inventory" FontSize="13" FontAttributes="Bold" TextColor="#D61B7A" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
