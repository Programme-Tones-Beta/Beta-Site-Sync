<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SiteSyncTracker.Views.InventoryPage"
             Title="Inventory">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
        <SearchBar x:Name="SearchEntry"
                   Grid.Row="0"
                   Placeholder="Search manifest or description"
                   TextChanged="OnSearchTextChanged" />

        <ActivityIndicator x:Name="LoadingIndicator"
                           Grid.Row="1"
                           IsVisible="False"
                           IsRunning="{Binding IsVisible, Source={x:Reference LoadingIndicator}}"
                           HorizontalOptions="Center" />

        <CollectionView x:Name="InventoryList"
                        Grid.Row="2"
                        EmptyView="No inventory items found.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12"
                            Margin="0,0,0,10"
                            Stroke="{StaticResource Gray300}"
                            StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="4">
                            <Label Text="{Binding ManifestNumber}"
                                   FontAttributes="Bold"
                                   FontSize="16" />
                            <Label Grid.Row="1"
                                   Text="{Binding Description}"
                                   LineBreakMode="WordWrap" />
                            <Label Grid.Row="2"
                                   Text="{Binding QuantityReceived, StringFormat='Received: {0}'}"
                                   TextColor="{StaticResource Gray500}" />
                            <Label Grid.Row="3"
                                   Text="{Binding QuantityExpected, StringFormat='Expected: {0}'}"
                                   TextColor="{StaticResource Gray500}" />
                            <Label Grid.Row="4"
                                   Text="{Binding DateUpdated, StringFormat='Updated: {0:G}'}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}" />
                            <VerticalStackLayout Grid.RowSpan="5"
                                                 Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="End">
                                <Label Text="{Binding CurrentStatus.StatusName}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource StatusBlue}" />
                                <Label Text="{Binding CurrentLocation.ZoneName}"
                                       TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
