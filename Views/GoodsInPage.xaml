<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SiteSyncTracker.Views.GoodsInPage"
             Title="Goods In">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Receive Delivery" FontSize="26" FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Manifest Number" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Placeholder="MAN-0000" MaxLength="50" HeightRequest="52" />
                <Button Grid.Column="1" Text="Scan" WidthRequest="96" HeightRequest="52" />
            </Grid>

            <Label Text="Description" />
            <Editor Placeholder="What was delivered?" AutoSize="TextChanges" MaxLength="255" HeightRequest="96" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout>
                    <Label Text="Qty Expected" />
                    <Entry Keyboard="Numeric" Placeholder="0" HeightRequest="52" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Qty Received" />
                    <Entry Keyboard="Numeric" Placeholder="0" HeightRequest="52" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="Location" />
            <Picker Title="Select location" HeightRequest="52">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Main Laydown Yard</x:String>
                        <x:String>Level 1 Structure</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Notify (phone or email)" />
            <Entry Placeholder="supervisor@example.com or +1 555 0100" Keyboard="Email" MaxLength="255" HeightRequest="52" />

            <Button Text="Confirm Receipt"
                    HeightRequest="64"
                    FontSize="20"
                    Margin="0,12,0,0"
                    BackgroundColor="{StaticResource StatusGreen}"
                    TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
