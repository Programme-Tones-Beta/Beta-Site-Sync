<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SiteSyncTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SiteSyncTracker"
    xmlns:views="clr-namespace:SiteSyncTracker.Views"
    Title="SiteSync Tracker">
    <TabBar>
        <ShellContent Title="Dashboard" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        <ShellContent Title="Goods In" ContentTemplate="{DataTemplate views:GoodsInPage}" Route="GoodsInPage" />
        <ShellContent Title="Goods Out" ContentTemplate="{DataTemplate views:GoodsOutPage}" Route="GoodsOutPage" />
        <ShellContent Title="Inventory" ContentTemplate="{DataTemplate views:InventoryPage}" Route="InventoryPage" />
    </TabBar>
</Shell>
